<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- luban on a Mac runs the Luban host machine and a system's machine with
     Virtualization.framework (Luban OS part 4 §6.6): this one entitlement,
     which an ad-hoc signature may carry. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.virtualization</key>
    <true/>
</dict>
</plist>
