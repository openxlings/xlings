# Maintainer: sunrisepeak <speakshen@163.com>
#
# Deployment S (SubOS design part 2 §5): /usr/bin/xlings belongs to pacman.
# Each user still has a home of their own (~/.xlings); the first command that
# writes one links its entry to this binary, so `pacman -Syu` upgrades every
# user and `xlings self update` points at pacman instead of replacing it.
#
# Nothing is installed but the binary: a user's home is created by xlings on
# first use, and it is user data -- removing this package never touches it.
#
# CI builds this package from the binary under test:
#   XLINGS_LOCAL_TARBALL=/path/xlings-<ver>-linux-x86_64.tar.gz makepkg
pkgname=xlings
pkgver=2026.10.4.1
pkgrel=1
pkgdesc="Universal package infrastructure with OS-like SubOS isolation"
arch=('x86_64')
url="https://github.com/openxlings/xlings"
license=('Apache-2.0')
depends=()
optdepends=('bubblewrap: kernel-enforced SubOS sandboxes'
            'passt: private networks (net=nat) for SubOS sandboxes')
if [[ -n ${XLINGS_LOCAL_TARBALL:-} ]]; then
    source=("$XLINGS_LOCAL_TARBALL")
    sha256sums=('SKIP')
else
    source=("https://github.com/openxlings/xlings/releases/download/v${pkgver}/xlings-${pkgver}-linux-x86_64.tar.gz")
    sha256sums=('721f0e3752f5a43b023ed12d6327757ffb51b7814e302c1c88e3c3bf4b00a0b0')
fi

package() {
  install -Dm755 "$srcdir/xlings-${pkgver}-linux-x86_64/bin/xlings" "$pkgdir/usr/bin/xlings"
}
